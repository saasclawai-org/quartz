[Unit]
Description=Quartz testnet node (standby/read-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/quartz-node/testnet.py
WorkingDirectory=/opt/quartz-node
Environment=QUARTZ_NO_MINER=1
Restart=always
RestartSec=5
# Hardening (harmless on any Debian/Raspberry Pi OS)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
