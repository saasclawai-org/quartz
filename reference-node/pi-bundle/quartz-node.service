[Unit]
Description=Quartz testnet node (gateway: standby + mining relay)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/quartz-node/testnet.py
WorkingDirectory=/opt/quartz-node
Environment=QUARTZ_NO_MINER=1
# P2P chain sync: comma-separated peer list — add friends' nodes too,
# e.g. QUARTZ_PEERS=https://quartz.preview.saasclaw.ai,http://192.168.1.42:21100
# (block-level incremental sync from whichever peer is furthest ahead;
# the 31MB snapshot is only pulled on first bootstrap / deep divergence)
Environment=QUARTZ_PEERS=https://quartz.preview.saasclaw.ai
# Gateway mode: ESP32s mine against THIS node on the LAN. Submits are
# relay-first — blocks build at the strongest tip; if the upstream is
# unreachable the node builds blocks LOCALLY on its synced chain
# (autonomy failover). Set QUARTZ_LOCAL_MINE=1 to always build locally.
Environment=QUARTZ_RELAY_URL=https://quartz.preview.saasclaw.ai
Restart=always
RestartSec=5
# Hardening (harmless on any Debian/Raspberry Pi OS)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
