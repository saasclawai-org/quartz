{
  "manifest_version": 3,
  "name": "Quartz Wallet",
  "version": "0.1.0",
  "description": "Quartz wallet extension — hold your keys, sign messages and logins. Makes zero network requests.",
  "icons": { "16": "icons/q16.png", "32": "icons/q32.png", "48": "icons/q48.png", "128": "icons/q128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Quartz Wallet" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["injected.js"], "world": "MAIN", "run_at": "document_start" },
    { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_start" }
  ],
  "permissions": ["storage"]
}
